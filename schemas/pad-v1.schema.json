{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperreal.local/schemas/pad-v1.schema.json",
  "title": "HYPERREAL pad record v1 draft",
  "type": "object",
  "required": ["schemaVersion", "slot", "midiNote", "mode", "sample", "edit", "mixer"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slot": { "type": "integer", "minimum": 1, "maximum": 16 },
    "midiNote": { "type": "integer", "minimum": 0, "maximum": 127 },
    "mode": { "enum": ["oneShot", "gated"] },
    "sample": {
      "type": ["object", "null"],
      "properties": {
        "contentId": { "type": "string" },
        "relativePath": { "type": "string" }
      },
      "additionalProperties": false
    },
    "edit": {
      "type": "object",
      "required": ["startFrame", "endFrame", "fadeInFrames", "fadeOutFrames", "reverse"],
      "properties": {
        "startFrame": { "type": "integer", "minimum": 0 },
        "endFrame": { "type": "integer", "minimum": 0 },
        "fadeInFrames": { "type": "integer", "minimum": 0 },
        "fadeOutFrames": { "type": "integer", "minimum": 0 },
        "reverse": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "mixer": {
      "type": "object",
      "required": ["level", "pan", "mute", "solo", "output"],
      "properties": {
        "level": { "type": "number", "minimum": 0, "maximum": 1 },
        "pan": { "type": "number", "minimum": -1, "maximum": 1 },
        "mute": { "type": "boolean" },
        "solo": { "type": "boolean" },
        "output": { "type": "integer", "minimum": 0, "maximum": 16 }
      },
      "additionalProperties": false
    },
    "tuning": { "type": "object" },
    "amplitudeEnvelope": { "type": "object" },
    "filterEnvelope": { "type": "object" },
    "filter": { "type": "object" },
    "lfo": { "type": "object" },
    "velocity": { "type": "object" },
    "polyphony": { "type": "integer", "minimum": 1 },
    "chokeGroup": { "type": ["integer", "null"], "minimum": 1 }
  },
  "additionalProperties": false
}
